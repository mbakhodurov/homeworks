# ----------------------------
# gRPC клиенты
# ----------------------------

# gRPC клиенты
INVENTORY_GRPC_HOST=localhost
INVENTORY_GRPC_PORT=50051
PAYMENT_GRPC_HOST=localhost
PAYMENT_GRPC_PORT=50052

# Http server
HTTP_HOST=localhost
HTTP_PORT=8080
HTTP_READ_TIMEOUT=5s
HTTP_SHUT_DOWN_TIMEOUT=10s

# Логгер
LOGGER_LEVEL=info
LOGGER_AS_JSON=true

# Postgresql
POSTGRES_IMAGE_NAME=postgres:18beta2-alpine3.22
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
EXTERNAL_POSTGRES_PORT=5432
POSTGRES_USER=order_user
POSTGRES_PASSWORD=order_password
POSTGRES_DB=order_db
POSTGRES_SSL_MODE=disable
MIGRATION_DIRECTORY=../../order/migrations