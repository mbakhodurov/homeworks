# -----------------------------------------
# Этот файл содержит все переменные окружения для всех сервисов
# с префиксами для избежания конфликтов имен.
# -----------------------------------------

# -----------------------------------------
# OBSERVABILITY (НАБЛЮДАЕМОСТЬ)
# -----------------------------------------

# Elasticsearch
OBSERVABILITY_ES_PORT=9200
OBSERVABILITY_ES_INTERNAL_PORT=9200

# Kibana
OBSERVABILITY_KIBANA_PORT=5601
OBSERVABILITY_KIBANA_INTERNAL_PORT=5601

# OTLP приёмники (OpenTelemetry Collector)
OBSERVABILITY_OTEL_GRPC_PORT=4317
OBSERVABILITY_OTEL_HTTP_PORT=4318
OBSERVABILITY_OTEL_INTERNAL_METRICS_PORT=8888
OBSERVABILITY_OTEL_PROM_EXPORTER_PORT=8889

# Prometheus
OBSERVABILITY_PROMETHEUS_PORT=9090

# Grafana
OBSERVABILITY_GRAFANA_PORT=3000
OBSERVABILITY_GRAFANA_ADMIN_USER=admin
OBSERVABILITY_GRAFANA_ADMIN_PASSWORD=admin

# -----------------------------------------
# CORE НАСТРОЙКИ (ОБЩИЕ КОМПОНЕНТЫ)
# -----------------------------------------

# Kafka настройки
CORE_KAFKA_EXTERNAL_PORT=9092
CORE_KAFKA_INTERNAL_PORT=29092
CORE_KAFKA_CONTROLLER_PORT=29093
CORE_KAFKA_UI_PORT=8090

# -----------------------------------------
# IAM СЕРВИС
# -----------------------------------------

# gRPC настройки
IAM_GRPC_HOST=localhost
IAM_GRPC_PORT=50053

# Логгер
IAM_LOGGER_LEVEL=info
IAM_LOGGER_AS_JSON=true

# OpenTelemetry / Logger
IAM_LOGGER_ENABLE_OTLP=true
IAM_OTLP_ENDPOINT=localhost:4317
IAM_SERVICE_NAME=iam-service
IAM_SERVICE_ENV=dev

# PostgreSQL
IAM_POSTGRES_HOST=localhost
IAM_POSTGRES_PORT=5444
IAM_EXTERNAL_POSTGRES_PORT=5444
IAM_POSTGRES_USER=iam_user
IAM_POSTGRES_PASSWORD=iam_password
IAM_POSTGRES_DB=iam
IAM_POSTGRES_SSL_MODE=disable
IAM_MIGRATION_DIRECTORY=../../iam/migrations

# Redis
IAM_REDIS_HOST=localhost
IAM_REDIS_PORT=6333
IAM_EXTERNAL_REDIS_PORT=6333
IAM_REDIS_CONNECTION_TIMEOUT=10s
IAM_REDIS_MAX_IDLE=10
IAM_REDIS_IDLE_TIMEOUT=10s

# Сессии
IAM_SESSION_TTL=24h

