{
  "id": null,
  "uid": "service-metrics-overview",
  "title": "Service Overview",
  "description": "orders_total, orders_revenue_total, assembly_duration_seconds",
  "tags": ["orders", "assembly", "metrics"],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"]
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "schemaVersion": 30,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Заказов создано (всего)",
      "description": "Накопленное значение счётчика orders_total",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr_old": "sum(orders_total)",
          "expr": "sum(last_over_time(orders_total[$__range]))",
          "legendFormat": "orders",
          "datasource": { "type": "prometheus", "uid": "prometheus-uid" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 1000 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Выручка (всего)",
      "description": "Накопленное значение счётчика orders_revenue_total",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr_old": "sum(orders_revenue_total)",
          "expr": "sum(last_over_time(orders_revenue_total[$__range]))",
          "legendFormat": "revenue",
          "datasource": { "type": "prometheus", "uid": "prometheus-uid" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10000 },
              { "color": "red", "value": 100000 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Среднее время сборки",
      "description": "Среднее значение гистограммы assembly_duration_seconds за последние 5 мин",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(assembly_duration_seconds_sum[5m])) / sum(rate(assembly_duration_seconds_count[5m]))",
          "legendFormat": "avg",
          "datasource": { "type": "prometheus", "uid": "prometheus-uid" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 8 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Скорость создания заказов",
      "description": "rate(orders_total[1m]) — заказов в секунду",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum(rate(orders_total[1m]))",
          "legendFormat": "orders/s",
          "datasource": { "type": "prometheus", "uid": "prometheus-uid" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "blue" }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 5,
      "title": "Скорость выручки",
      "description": "rate(orders_revenue_total[1m]) — выручка в секунду (по валюте если есть label)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum by (currency) (rate(orders_revenue_total[1m]))",
          "legendFormat": "{{currency}}",
          "datasource": { "type": "prometheus", "uid": "prometheus-uid" }
        },
        {
          "expr": "sum(rate(orders_revenue_total[1m]))",
          "legendFormat": "total",
          "datasource": { "type": "prometheus", "uid": "prometheus-uid" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    },
    {
      "id": 6,
      "title": "Время сборки — перцентили",
      "description": "histogram_quantile по assembly_duration_seconds: p50, p95, p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(assembly_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p50",
          "datasource": { "type": "prometheus", "uid": "prometheus-uid" }
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(assembly_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95",
          "datasource": { "type": "prometheus", "uid": "prometheus-uid" }
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(assembly_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99",
          "datasource": { "type": "prometheus", "uid": "prometheus-uid" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p99" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p95" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p50" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "last"] }
      }
    }
  ]
}
